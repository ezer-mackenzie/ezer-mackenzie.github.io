---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StackGroup from '../components/StackGroup.astro';

const pageTitle = 'Eli-ezer Ramírez | Software Engineer, Data Engineer & Python Developer';
const pageDescription =
  'Software Engineer y Data Engineer en Chile especializado en Python, APIs, datos, backend, automatización y proyectos open source con impacto real. Portfolio profesional de Eli-ezer Ramírez.';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Eli-ezer Ramírez',
  url: 'https://ezer-mackenzie.github.io/',
  inLanguage: 'es-CL',
  description:
    'Portfolio profesional de Eli-ezer Ramírez, Software Engineer y Data Engineer especializado en Python, backend, APIs y datos.',
  publisher: {
    '@type': 'Person',
    name: 'Eli-ezer Ramírez',
  },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eli-ezer Ramírez',
  jobTitle: 'Software Engineer',
  description:
    'Software Engineer y Data Engineer en Chile con enfoque en Python, APIs, automatización, datos y soluciones open source.',
  url: 'https://ezer-mackenzie.github.io/',
  sameAs: [
    'https://www.linkedin.com/in/eli-ezer-ramirez',
    'https://github.com/ezer-mackenzie',
  ],
  knowsAbout: [
    'Data Engineering',
    'Software Development',
    'Backend APIs',
    'Data Analytics',
    'Python Development',
    'Open Source',
  ],
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CL',
    addressLocality: 'Santiago',
  },
};

type ProjectVisibility = 'public' | 'private' | 'in-progress';

interface FeaturedProject {
  title: string;
  description: string;
  stack: string[];
  href?: string;
  category: string;
  accent: string;
  visibility: ProjectVisibility;
}

const featuredProjects: FeaturedProject[] = [
  {
    title: 'chile-aviation-analytics',
    description:
      'Proyecto de análisis y transformación de datasets chilenos de aviación para workflows analíticos, visualización de tendencias y estudios sectoriales.',
    stack: ['Python', 'Data Analytics', 'Pandas'],
    href: 'https://github.com/ezer-mackenzie/chile-aviation-analytics',
    category: 'Data & Analytics',
    accent: '#7dd3fc',
    visibility: 'public',
  },
  {
    title: 'bcch-sdk',
    description:
      'SDK de Python para acceder series macroeconómicas del Banco Central de Chile con clientes sincrónicos y asíncronos, modelos tipados y soporte nativo para Pandas y Polars.',
    stack: ['Python', 'Pandas', 'Polars', 'AsyncIO'],
    href: 'https://github.com/ezer-mackenzie/bcch-sdk',
    category: 'Open Source',
    accent: '#a78bfa',
    visibility: 'public',
  },
  {
    title: 'chile-public-market-sdk',
    description:
      'SDK para simplificar el acceso a datos de compras públicas chilenas y crear apps con una capa más amigable para desarrolladores.',
    stack: ['Python', 'APIs', 'Public Data'],
    href: 'https://github.com/ezer-mackenzie/chile-public-market-sdk',
    category: 'Developer Tooling',
    accent: '#34d399',
    visibility: 'public',
  },
  {
    title: 'rut-validator',
    description:
      'Librería ligera para validar, normalizar y formatear RUTs chilenos con verificación módulo 11 y foco en robustez y simplicidad.',
    stack: ['Python', 'PyPI', 'Validation'],
    href: 'https://github.com/ezer-mackenzie/rut-validator',
    category: 'Utilities',
    accent: '#f9a8d4',
    visibility: 'public',
  },
  {
    title: 'discord-rut-transformer',
    description:
      'Transformador reutilizable para comandos de Discord que integra validación de RUT y automatización de workflows en bots.',
    stack: ['Python', 'discord.py', 'Automation'],
    href: 'https://github.com/ezer-mackenzie/discord-rut-transformer',
    category: 'Bots',
    accent: '#fbbf24',
    visibility: 'public',
  },
  {
    title: 'benchcore',
    description:
      'Framework ligero para benchmarking de ejecución, recolección de resultados y construcción de flujos personalizados de medición.',
    stack: ['Python', 'Benchmarking', 'PyPI'],
    href: 'https://github.com/ezer-mackenzie/benchcore',
    category: 'Performance',
    accent: '#38bdf8',
    visibility: 'public',
  },
];

const projectQuickLinks = featuredProjects.map((project) => ({
  title: project.title,
  href: project.href ?? '/proyectos',
  description: project.description,
  external: project.href?.startsWith('http') ?? false,
}));

const stackGroups = [
  {
    title: 'Data & Analytics',
    items: ['Python', 'Pandas', 'Polars', 'SQL', 'Data Analysis', 'Data Processing'],
  },
  {
    title: 'Backend & APIs',
    items: ['FastAPI', 'NestJS', 'Node.js', 'REST APIs', 'Microservices', 'Redis'],
  },
  {
    title: 'Frontend',
    items: ['Angular', 'Next.js', 'React', 'TypeScript', 'HTML/CSS', 'Tailwind CSS'],
  },
  {
    title: 'Databases',
    items: ['PostgreSQL', 'SQL Server', 'MySQL', 'MongoDB', 'Firebase', 'SQLite'],
  },
  {
    title: 'Cloud & DevOps',
    items: ['Docker', 'Kubernetes', 'AWS', 'GCP', 'Vercel', 'NGINX', 'Git', 'CI/CD', 'Linux'],
  },
  {
    title: 'Other',
    items: ['Kotlin', 'Odin'],
  },
];

const currentBuilds = [
  {
    title: 'Mercado Público Platform',
    description:
      'Ecosistema de herramientas para hacer más accesible, searchable y útil la información de compras públicas en Chile.',
    tag: 'Python · FastAPI · Discord · Public APIs',
  },
  {
    title: 'BCCh Data Platform',
    description:
      'Herramientas para consultar y explotar indicadores económicos oficiales del Banco Central de Chile con mayor facilidad.',
    tag: 'Python · FastAPI · Pandas · Polars · Economic Data',
  },
  {
    title: 'Data operations & automation',
    description:
      'Flujos de extracción, modelado y automatización para transformar datos complejos en servicios útiles y mantenibles.',
    tag: 'Automation · Data · APIs · Dev Tools',
  },
];

const faqEntries = [
  {
    question: '¿Qué tipo de software construye Eli-ezer Ramírez?',
    answer:
      'Construye soluciones en Python, APIs, data engineering, automatización y herramientas open source orientadas a datos y productos útiles para usuarios y equipos.',
  },
  {
    question: '¿En qué áreas tiene experiencia?',
    answer:
      'Tiene experiencia en datos públicos, analítica, backend, automatización de procesos, integración de APIs, desarrollo de librerías y herramientas para desarrolladores.',
  },
  {
    question: '¿Trabaja con proyectos de datos y open source?',
    answer:
      'Sí. Gran parte de su trabajo se centra en datos, herramientas reutilizables, código abierto y soluciones técnicas con impacto real en Chile y ecosistemas de datos.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} canonicalURL="https://ezer-mackenzie.github.io/" image="/favicon.svg">
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="site-shell">
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href="#home">
          <span class="brand-mark">ER</span>
          <span>Eli-ezer Ramírez</span>
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir menú">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </button>

        <nav id="main-nav" class="nav" aria-label="Navegación principal">
          <a href="#about">Sobre mí</a>
          <a href="/proyectos">Portfolio</a>
          <a href="#stack">Stack</a>
          <a href="#contact">Contacto</a>
        </nav>
      </div>
    </header>

    <main id="home">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <span class="kicker">Software Engineer · Chile</span>
            <h1>
              Construyo software para <span class="highlight">dar sentido a los datos</span>
            </h1>
            <p class="hero-copy">
              Soy Eli-ezer Ramírez, un Software Engineer de Santiago, Chile, interesado en Data Science,
              Data Engineering, backend y open source. Me apasiona transformar información compleja en
              herramientas útiles para personas, equipos y negocios.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="/proyectos">Ver portfolio de proyectos</a>
              <a class="btn btn-secondary" href="https://www.linkedin.com/in/eli-ezer-ramirez" target="_blank" rel="noreferrer">LinkedIn</a>
            </div>

            <div class="hero-metrics" aria-label="estadísticas de perfil">
              <div class="metric">
                <strong>+10</strong>
                <span>Repos</span>
              </div>
              <div class="metric">
                <strong>Data</strong>
                <span>Focus</span>
              </div>
              <div class="metric">
                <strong>Open</strong>
                <span>Source</span>
              </div>
            </div>
          </div>

          <aside class="profile-card" aria-label="Perfil profesional">
            <div class="profile-glow"></div>
            <div class="card-panel">
              <div class="avatar" aria-hidden="true">👨‍💻</div>
              <div class="status-row">
                <strong>Disponible para colaborar</strong>
                <span class="online-dot" aria-label="online"></span>
              </div>
              <p class="profile-summary">
                Trabajo especialmente con datos públicos y económicos chilenos, mientras exploro aplicaciones
                de software y análisis en finanzas, minería, servicios públicos y aviación.
              </p>
            </div>
          </aside>
        </div>
      </section>

      <section id="about" class="section">
        <div class="container">
          <SectionHeader
            eyebrow="Sobre mí"
            title="Software con propósito, datos con impacto y productos que resuelven problemas reales."
            description="Mi trabajo se centra en construir herramientas, APIs y librerías que conviertan datasets complejos en accesibles y accionables. Me interesa especialmente el problema de convertir información pública o económica en soluciones prácticas para desarrolladores, analistas y usuarios finales."
          />
        </div>
      </section>

      <section id="projects" class="section">
        <div class="container">
          <SectionHeader
            eyebrow="Proyectos"
            title="Librerías, APIs y proyectos de datos que impulsan ideas y automatización."
            description="Un conjunto de iniciativas enfocadas en datos públicos, herramientas para desarrolladores, análisis y automatización de workflows con un enfoque práctico y reutilizable."
          />

          <div class="project-preview-tools">
            <div class="project-list" aria-label="Proyectos destacados">
              {projectQuickLinks.map((project, index) => (
                <div class="project-list-item">
                  <input
                    type="radio"
                    name="project-accordion"
                    id={`project-${index}`}
                    checked={index === 0}
                  />
                  <label class="project-trigger" for={`project-${index}`}>
                    <span>{project.title}</span>
                    <span class="summary-icon" aria-hidden="true">+</span>
                  </label>
                  <div class="project-item-content">
                    <p>{project.description}</p>
                    <a href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noreferrer' : undefined}>
                      {project.external ? 'Ver proyecto' : 'Saber más'}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="building" class="section">
        <div class="container">
          <SectionHeader
            eyebrow="Actualmente construyendo"
            title="Ecosistemas y servicios que vuelven más fácil el acceso a datos públicos y económicos."
          />

          <div class="building-grid">
            {currentBuilds.map((item) => (
              <article class="build-item">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="tag">{item.tag}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="stack" class="section">
        <div class="container">
          <SectionHeader
            eyebrow="Tech Stack"
            title="Una base sólida para datos, backend y productos de software."
            description="Combino herramientas de análisis, backend, frontend y despliegue para construir soluciones integrales, mantenibles y útiles en la práctica."
          />

          <div class="stack-grid">
            {stackGroups.map((group) => <StackGroup title={group.title} items={group.items} />)}
          </div>
        </div>
      </section>

      <section id="faq" class="section">
        <div class="container">
          <SectionHeader
            eyebrow="FAQ"
            title="Preguntas frecuentes sobre mi trabajo y especialidad."
            description="Respuestas rápidas para entender mi enfoque, áreas de especialización y el tipo de soluciones que construyo."
          />

          <div class="faq-grid">
            {faqEntries.map((item) => (
              <article class="faq-item">
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="section">
        <div class="container">
          <div class="contact-box">
            <div class="contact-copy">
              <h3>Hablemos de datos, software y colaboraciones.</h3>
              <p>Estoy abierto a proyectos de open source, backend, data, APIs y soluciones con impacto real.</p>
            </div>
            <div class="hero-actions">
              <a class="btn btn-primary" href="https://www.linkedin.com/in/eli-ezer-ramirez" target="_blank" rel="noreferrer">Contactar por LinkedIn</a>
              <a class="btn btn-secondary" href="https://github.com/ezer-mackenzie" target="_blank" rel="noreferrer">Ver perfil de GitHub</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© 2026 Eli-ezer Ramírez</span>
        <span>Software Engineer · Data · Backend · Open Source</span>
      </div>
    </footer>
  </div>

  <script lang="ts">
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('.nav');

    if (toggle && nav) {
      const syncMenuState = (isOpen: boolean): void => {
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.classList.toggle('is-open', isOpen);
        nav.classList.toggle('is-open', isOpen);
        toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      };

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        syncMenuState(!expanded);
      });

      nav.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
        link.addEventListener('click', () => {
          syncMenuState(false);
        });
      });
    }

  </script>
</Layout>

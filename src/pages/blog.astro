---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { posts } from '../data/blog';

const pageTitle = 'Blog | Eli-ezer Ramírez';
const pageDescription =
  'Artículos y reflexiones sobre software, Python, datos, APIs, backend y productividad técnica con enfoque práctico y aplicado.';

const articles = posts.map((post) => ({
  title: post.title,
  description: post.description,
  href: `/blog/${post.slug}`,
  tag: post.category,
}));

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de Eli-ezer Ramírez',
  description: pageDescription,
  url: 'https://ezer-mackenzie.github.io/blog',
  publisher: {
    '@type': 'Person',
    name: 'Eli-ezer Ramírez',
  },
};
---

<Layout title={pageTitle} description={pageDescription} canonicalURL="https://ezer-mackenzie.github.io/blog" image="/favicon.svg">
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <div class="site-shell">
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark">ER</span>
          <span>Eli-ezer Ramírez</span>
        </a>

        <nav class="nav" aria-label="Navegación principal">
          <a href="/">Inicio</a>
          <a href="/proyectos">Portfolio</a>
          <a href="/#contact">Contacto</a>
        </nav>
      </div>
    </header>

    <main class="section">
      <div class="container">
        <SectionHeader
          eyebrow="Blog"
          title="Artículos sobre software, Python y datos."
          description="Reflexiones y guías prácticas sobre ingeniería de software, backend, análisis de datos y construcción de herramientas con impacto real."
        />

        <div class="articles-grid">
          {articles.map((article) => (
            <article class="article-card">
              <span class="tag">{article.tag}</span>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
              <a href={article.href}>Leer artículo</a>
            </article>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .site-shell {
    min-height: 100vh;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(18px);
    background: rgba(2, 8, 23, 0.58);
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.4rem;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.75rem;
    color: #0f172a;
    background: linear-gradient(135deg, #7dd3fc, #d8b4fe);
    font-size: 0.8rem;
    box-shadow: 0 10px 24px rgba(125, 211, 252, 0.35);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .nav a {
    color: #dbeafe;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.55rem 0.82rem;
    border-radius: 999px;
    border: 1px solid transparent;
  }

  .nav a:hover {
    color: white;
    background: rgba(148, 163, 184, 0.08);
    border-color: rgba(148, 163, 184, 0.18);
  }

  .section {
    padding: 4rem 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 1.5rem;
  }

  .article-card {
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.38rem 0.7rem;
    font-size: 0.72rem;
    background: rgba(167, 139, 250, 0.12);
    border: 1px solid rgba(167, 139, 250, 0.2);
    color: #e9d5ff;
  }

  h3 {
    margin: 1rem 0 0.75rem;
    font-size: 1.5rem;
    letter-spacing: -0.04em;
  }

  p {
    margin: 0 0 1rem;
    color: #dbeafe;
    line-height: 1.7;
  }

  a {
    color: #7dd3fc;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .articles-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 820px) {
    .topbar-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 0.8rem 0;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
